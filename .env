# Copy this file to .env and fill in your own key.
# Only needed for open-ended questions outside the 5 known test questions -
# those are answered deterministically without any API key.

# Internal service addresses used by the Next.js server-side route handlers.
PYTHON_API_URL=http://127.0.0.1:8000
DOCUMENT_ASSISTANT_API_URL=http://127.0.0.1:8001
   OPENROUTER_API_KEY=enter your key here
   OPENROUTER_MODEL=openai/gpt-4o-mini
